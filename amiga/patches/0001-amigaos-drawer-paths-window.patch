@@ -5,6 +5,21 @@
 #ifndef NAMES_H
 #define NAMES_H
 
+#ifdef __amigaos__
+/* AmigaOS: the game's files in PROGDIR:Data, the player's in PROGDIR:User.
+ * A volume name ends in ':', so the local path is localname (PROGDIR:)
+ * and localdirname joined with no '/' between (LOCALSEP), and LIBPATH is
+ * one drawer, not a ':'-separated list (scav.c expandpath). */
+#define LIBPATH "PROGDIR:Data"
+#define LOCALDIRNAME "User"
+#define LOCALHOME "PROGDIR:"
+#define LOCALSEP ""
+#define LOGNAME "PROGDIR:User/SCAVINFO.LOG"
+#else
+#define LOCALSEP "/"
+#define LOGNAME "SCAVINFO.LOG"
+#endif
+
 #ifndef LIBPATH
 #if defined(__WIN32__) || defined(WIN32)
 #define LIBPATH "data"
